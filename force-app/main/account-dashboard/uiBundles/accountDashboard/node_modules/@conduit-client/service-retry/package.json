    },
    "dependencies": {
        "@conduit-client/utils": "3.17.0"
    },
    "volta": {
        "extends": "../../../../package.json"
    },
    "size-limit": [
        {
            "path": "./dist/v1/index.js",
            "limit": "1.4 kB"
        }
