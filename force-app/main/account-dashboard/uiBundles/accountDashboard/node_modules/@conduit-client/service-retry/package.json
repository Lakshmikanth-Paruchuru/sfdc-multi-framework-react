{
    "name": "@conduit-client/service-retry",
    "version": "3.17.0",
    "private": false,
    "description": "Luvio Retry Service definition",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/salesforce-experience-platform-emu/onestore.git",
        "directory": "packages/@conduit-client/services/retry"
    },
    "license": "SEE LICENSE IN LICENSE.txt",
    "exports": {
        "./v1": {
            "import": "./dist/v1/index.js",
